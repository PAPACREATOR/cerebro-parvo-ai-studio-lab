{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "max_text_chars",
    "prefixes",
    "natural_rules",
    "clarification_patterns",
    "operation_rules"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "max_text_chars": {
      "const": 100000
    },
    "prefixes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 2
          },
          {
            "enum": [
              "arquivo",
              "web",
              "fontes",
              "trabalhar",
              "perguntar",
              "calcular",
              "tema"
            ]
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "clarification_patterns": {
      "$ref": "#/$defs/patterns"
    },
    "natural_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arquivo",
        "web",
        "fontes",
        "trabalhar",
        "perguntar",
        "calcular",
        "tema"
      ],
      "properties": {
        "arquivo": {
          "$ref": "#/$defs/patterns"
        },
        "web": {
          "$ref": "#/$defs/patterns"
        },
        "fontes": {
          "$ref": "#/$defs/patterns"
        },
        "trabalhar": {
          "$ref": "#/$defs/patterns"
        },
        "perguntar": {
          "$ref": "#/$defs/patterns"
        },
        "calcular": {
          "$ref": "#/$defs/patterns"
        },
        "tema": {
          "$ref": "#/$defs/patterns"
        }
      }
    },
    "operation_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "process",
          "intent",
          "requires_attachment",
          "patterns"
        ],
        "properties": {
          "process": {
            "enum": [
              "verify",
              "convert_pdf",
              "book"
            ]
          },
          "intent": {
            "enum": [
              "arquivo",
              "web",
              "fontes",
              "trabalhar",
              "perguntar",
              "calcular",
              "tema"
            ]
          },
          "requires_attachment": {
            "type": "boolean"
          },
          "patterns": {
            "$ref": "#/$defs/patterns"
          }
        }
      }
    }
  },
  "$defs": {
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
