{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "outcome",
    "title",
    "markdown",
    "evidence",
    "ai_calls"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "BLOCKED"
      ]
    },
    "outcome": {
      "enum": [
        "agreement",
        "conflict",
        "unknown",
        "failure",
        "candidate"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "status",
          "value"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100000
          }
        }
      }
    },
    "ai_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "const": "resultado.pdf"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "agreement"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "conflict"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "UNKNOWN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "unknown"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "UNKNOWN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failure"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "FAIL"
          }
        }
      }
    }
  ]
}
